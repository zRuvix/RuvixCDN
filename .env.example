# Copy to .env for local dev: cp .env.example .env
# Never commit real values. See CLAUDE.md §5.

LISTEN_ADDR=127.0.0.1:8080
DATA_DIR=./data/files
PUBLIC_URL=http://localhost:8080
ADMIN_USER=admin
# Generate with: go run ./cmd/hashpw
ADMIN_PASS_HASH=
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=
SESSION_TTL=12h
MAX_UPLOAD_MB=50
CACHE_MAX_AGE=86400
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1/32
LOG_LEVEL=info
# Dev only: allow non-Secure cookies over http. Refused when PUBLIC_URL is https.
COOKIE_INSECURE=true
